{:paths ["src"]
 :deps  {
         datalevin-bench/host                          {:local/root "../host-control"}
         datalevin/datalevin                           {:local/root "../.."}
         org.clojure/clojure                           {:mvn/version "1.12.5"}
         com.cognitect/transit-clj                     {:mvn/version "1.0.333"}
         com.taoensso/nippy                            {:mvn/version "3.9.0"}
         me.lemire.integercompression/JavaFastPFOR     {:mvn/version "0.3.10"}
         org.clojars.huahaiy/dtlvnative-macosx-arm64   {:mvn/version "0.19.4"}
         org.clojars.huahaiy/dtlvnative-linux-arm64    {:mvn/version "0.19.4"}
         org.clojars.huahaiy/dtlvnative-linux-x86_64   {:mvn/version "0.19.4"}
         org.clojars.huahaiy/dtlvnative-windows-x86_64 {:mvn/version "0.19.4"}
         org.roaringbitmap/RoaringBitmap               {:mvn/version "1.3.0"}
         org.eclipse.collections/eclipse-collections   {:mvn/version "13.0.0"}
         com.github.luben/zstd-jni                     {:mvn/version "1.5.7-6"}
         org.xerial/sqlite-jdbc                        {:mvn/version "3.51.1.0"}
         org.postgresql/postgresql                     {:mvn/version "42.7.5"}
         }

 :aliases
 {:dev
  {:extra-paths ["target/classes"]
   :jvm-opts    ["--add-opens=java.base/java.nio=ALL-UNNAMED"
                 "--add-opens=java.base/sun.nio.ch=ALL-UNNAMED"
                 "--enable-native-access=ALL-UNNAMED"
                 "-Dclojure.compiler.direct-linking=true"]}

  :test
  {:extra-paths ["test"]
   :jvm-opts    ["--add-opens=java.base/java.nio=ALL-UNNAMED"
                 "--add-opens=java.base/sun.nio.ch=ALL-UNNAMED"
                 "--enable-native-access=ALL-UNNAMED"
                 "-Dclojure.compiler.direct-linking=true"]
   :extra-deps  {io.github.cognitect-labs/test-runner
                 {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
   :main-opts   ["-m" "cognitect.test-runner"]
   :exec-fn     cognitect.test-runner.api/test}

  :datalevin-db
  {:jvm-opts ["--add-opens=java.base/java.nio=ALL-UNNAMED"
              "--add-opens=java.base/sun.nio.ch=ALL-UNNAMED"
              "--enable-native-access=ALL-UNNAMED"
              "-Dclojure.compiler.direct-linking=true"]
   :exec-fn  datalevin-tpch.datalevin/db}

  :datalevin-bench
  {:jvm-opts  ["--add-opens=java.base/java.nio=ALL-UNNAMED"
               "--add-opens=java.base/sun.nio.ch=ALL-UNNAMED"
               "--enable-native-access=ALL-UNNAMED"
               "-Dclojure.compiler.direct-linking=true"]
   :main-opts ["-m" "datalevin-tpch.datalevin"]
   :exec-fn   datalevin-tpch.datalevin/bench}

  :sqlite-db
  {:jvm-opts ["-Dclojure.compiler.direct-linking=true"]
   :exec-fn  datalevin-tpch.sqlite/db}

  :sqlite-bench
  {:jvm-opts  ["-Dclojure.compiler.direct-linking=true"]
   :main-opts ["-m" "datalevin-tpch.sqlite"]
   :exec-fn   datalevin-tpch.sqlite/bench}

  :pg-db
  {:jvm-opts ["-Dclojure.compiler.direct-linking=true"]
   :exec-fn  datalevin-tpch.postgres/db}

  :pg-bench
  {:jvm-opts  ["-Dclojure.compiler.direct-linking=true"]
   :main-opts ["-m" "datalevin-tpch.postgres"]
   :exec-fn   datalevin-tpch.postgres/bench}

  :verify
  {:jvm-opts ["--add-opens=java.base/java.nio=ALL-UNNAMED"
              "--add-opens=java.base/sun.nio.ch=ALL-UNNAMED"
              "--enable-native-access=ALL-UNNAMED"
              "-Dclojure.compiler.direct-linking=true"]
   :exec-fn  datalevin-tpch.verify/verify}}}
