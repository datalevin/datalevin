{:paths ["src"]
 :deps {datalevin/datalevin {:local/root "../.."
                             :exclusions [io.netty/netty-all]}
        org.clojure/clojure {:mvn/version "1.12.5"}}
 :aliases
 {:load {:jvm-opts ["-Dclojure.compiler.direct-linking=true"]
         :main-opts ["-m" "ldbc-snb-bench.core" "load"]}
  :bench {:jvm-opts ["-Dclojure.compiler.direct-linking=true"]
          :main-opts ["-m" "ldbc-snb-bench.core" "bench"]}
  :neo4j-bench {:extra-deps {org.neo4j/neo4j {:mvn/version "2026.06.0"}}
                :jvm-opts ["-Dclojure.compiler.direct-linking=true"]
                :main-opts ["-m" "ldbc-snb-bench.neo4j"]}
  :compare {:main-opts ["-m" "ldbc-snb-bench.comparison"]}
  :repl {:main-opts ["-m" "nrepl.cmdline" "--middleware" "[cider.nrepl/cider-middleware]"]}
  :test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner {:git/tag "v0.5.1" :git/sha "dfb30dd"}
                      org.neo4j/neo4j {:mvn/version "2026.06.0"}}
         :main-opts ["-m" "cognitect.test-runner"]}}}
