{:paths ["src"]
 :deps  {org.clojure/clojure {:mvn/version "1.12.4"}}

 :aliases
 {:datalevin
  {:extra-deps {datalevin/datalevin {:local/root "../.."}}
   :jvm-opts   ["--add-opens=java.base/java.nio=ALL-UNNAMED"
                "--add-opens=java.base/sun.nio.ch=ALL-UNNAMED"
                "--enable-native-access=ALL-UNNAMED"]}

  :sqlite
  {:extra-deps {org.xerial/sqlite-jdbc {:mvn/version "3.51.1.0"}}}

  :postgresql
  {:extra-deps {org.postgresql/postgresql {:mvn/version "42.7.5"}}}

  :xsb {}
  :souffle {}

  :clara
  {:extra-deps {com.cerner/clara-rules {:mvn/version "0.24.0"}}}

  :odoyle
  {:extra-deps {net.sekao/odoyle-rules {:mvn/version "1.3.1"}}}

  :ore-rl
  {:extra-deps {datalevin/datalevin {:local/root "../.."}
                net.sourceforge.owlapi/owlapi-distribution
                {:mvn/version "5.5.1"}
                org.eclipse.rdf4j/rdf4j-runtime {:mvn/version "5.2.0"}}}

  :test
  {:extra-paths ["test"]
   :main-opts   ["-m" "openrulebench.test-runner"]}}}
